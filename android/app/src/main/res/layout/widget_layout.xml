<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_background"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stay Productive!"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_empty_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open StudentPal to add classes"
            android:textSize="10sp"
            android:textColor="#88FFFFFF"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- 2x2 GRID CONTENT -->
    <GridLayout
        android:id="@+id/widget_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:padding="8dp"
        android:rowCount="2"
        android:columnCount="2"
        android:useDefaultMargins="false">

        <!-- TOP LEFT: Current Class -->
        <LinearLayout
            android:id="@+id/widget_current_class"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_section_background"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/widget_current_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CURRENT CLASS"
                android:textSize="8sp"
                android:textColor="#00E676"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_current_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_current_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="9sp"
                android:textColor="#88FFFFFF"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- TOP RIGHT: Next Class -->
        <LinearLayout
            android:id="@+id/widget_next_class"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_section_background"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/widget_next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEXT CLASS"
                android:textSize="8sp"
                android:textColor="#2196F3"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_next_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_next_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="11sp"
                android:textColor="#2196F3"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- BOTTOM LEFT: Today's Schedule -->
        <LinearLayout
            android:id="@+id/widget_schedule"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_section_background"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_schedule_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TODAY'S SCHEDULE"
                android:textSize="8sp"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_schedule_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_schedule_sublabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="classes left"
                android:textSize="9sp"
                android:textColor="#88FFFFFF"
                android:fontFamily="sans-serif"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- BOTTOM RIGHT: Assignments -->
        <LinearLayout
            android:id="@+id/widget_assignments"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_section_background"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_assignments_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASSIGNMENTS"
                android:textSize="8sp"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_assignments_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_assignments_sublabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="pending"
                android:textSize="9sp"
                android:textColor="#88FFFFFF"
                android:fontFamily="sans-serif"
                android:layout_marginTop="1dp" />

        </LinearLayout>

    </GridLayout>

</FrameLayout>
