<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  STUDENT PAL 2x2 HOME SCREEN WIDGET — LAYOUT REFERENCE
  ============================================================================
  VISUAL PROPERTIES YOU CAN ADJUST (search for each tag below):

  CARD CORNER RADIUS  → edit res/drawable/widget_background.xml          (root)
                          and res/drawable/widget_section_background.xml   (quadrants)
  CARD BACKGROUND     → edit the <solid android:color="..."/> in the same two files
  CARD DIMENSIONS     → adjust android:layout_margin* values below (currently 2dp)
  TEXT PADDING        → adjust android:padding values on each quadrant LinearLayout (currently 8dp)
  ROOT PADDING        → adjust android:padding on the root FrameLayout (currently 4dp)
  GRID GAP           → adjust android:padding on the GridLayout (currently 8dp)
  LABEL COLOR        → edit android:textColor on each label TextView below
  ============================================================================
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- ===== EMPTY STATE (shown when there's no data or an error) ===== -->
    <LinearLayout
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_background"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stay Productive!"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_empty_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open StudentPal to add classes"
            android:textSize="10sp"
            android:textColor="#88FFFFFF"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- ===== 2x2 GRID CONTENT (shown when data is available) ===== -->
    <!--
      Grid gap is controlled by android:padding here (8dp).
      The GridLayout has internal margins of 0 — all spacing comes from the
      quadrant child margins, root padding, and grid padding combined.
    -->
    <GridLayout
        android:id="@+id/widget_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:padding="8dp"
        android:rowCount="2"
        android:columnCount="2"
        android:useDefaultMargins="false">

        <!-- ===== TOP LEFT: Current Class ===== -->
        <!--
          CARD WIDTH/HEIGHT: controlled by layout_columnWeight="1" / layout_rowWeight="1"
          Each quadrant gets 50% width and 50% height of the grid area.
          INTERNAL PADDING (text inset): android:padding="8dp"
          MARGIN (gap to neighbors): android:layout_marginEnd/Bottom/Top/Start
        -->
        <LinearLayout
            android:id="@+id/widget_current_class"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_section_background"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp">

            <!-- LABEL — adjust textSize, textColor for the section header -->
            <TextView
                android:id="@+id/widget_current_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CURRENT CLASS"
                android:textSize="8sp"
                android:textColor="#00E676"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true" />

            <!-- TITLE — adjust textSize for the primary value -->
            <TextView
                android:id="@+id/widget_current_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <!-- SUBTITLE — adjust textSize for secondary info -->
            <TextView
                android:id="@+id/widget_current_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="9sp"
                android:textColor="#88FFFFFF"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- ===== TOP RIGHT: Next Class ===== -->
        <LinearLayout
            android:id="@+id/widget_next_class"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_section_background"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/widget_next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEXT CLASS"
                android:textSize="8sp"
                android:textColor="#2196F3"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_next_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_next_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="11sp"
                android:textColor="#2196F3"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- ===== BOTTOM LEFT: Today's Schedule ===== -->
        <LinearLayout
            android:id="@+id/widget_schedule"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_section_background"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_schedule_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TODAY'S SCHEDULE"
                android:textSize="8sp"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true" />

            <!-- LARGE COUNT — adjust textSize for the big number display -->
            <TextView
                android:id="@+id/widget_schedule_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_schedule_sublabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="classes left"
                android:textSize="9sp"
                android:textColor="#88FFFFFF"
                android:fontFamily="sans-serif"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- ===== BOTTOM RIGHT: Assignments ===== -->
        <LinearLayout
            android:id="@+id/widget_assignments"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_section_background"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_assignments_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASSIGNMENTS"
                android:textSize="8sp"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_assignments_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_assignments_sublabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="pending"
                android:textSize="9sp"
                android:textColor="#88FFFFFF"
                android:fontFamily="sans-serif"
                android:layout_marginTop="1dp" />

        </LinearLayout>

    </GridLayout>

</FrameLayout>
