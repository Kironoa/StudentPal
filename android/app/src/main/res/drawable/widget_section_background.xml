<?xml version="1.0" encoding="utf-8"?>
<!--
  STUDENT PAL WIDGET — QUADRANT CARD BACKGROUND
  ==============================================
  EDIT THESE PROPERTIES:

  CARD FILL:         change the #RRGGBB value in <solid android:color="..."/>
                     #1AFFFFFF = 10% white overlay on the root background
                     Increase alpha (e.g. 33FFFFFF) for lighter cards.
                     Decrease alpha (e.g. 0AFFFFFF) for more transparent cards.
  CORNER RADIUS:     change android:radius value (currently 8dp)
                     Keep this smaller than the root radius (12dp) by 2-4dp
                     for a layered card look.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1AFFFFFF" />
    <corners android:radius="8dp" />
</shape>
